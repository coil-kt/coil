{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "automerge": false,
    "dependencyDashboard": false,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^gradle/libs\\.versions\\.toml$/"],
            "matchStrings": ["android-ndk\\s*=\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
            "depNameTemplate": "android/ndk",
            "datasourceTemplate": "custom.android-ndk",
            "versioningTemplate": "semver",
        },
    ],
    "customDatasources": {
        "android-ndk": {
            "defaultRegistryUrlTemplate": "https://dl.google.com/android/repository/repository2-3.xml",
            "format": "plain",
            "transformTemplates": [
                "$match($join(releases.version, ''), /<remotePackage\\b[^>]*\\bpath=\"ndk;([0-9]+\\.[0-9]+\\.[0-9]+)\"[^>]*>[\\s\\S]*?<\\/remotePackage>/)",
                "{'releases': [$[$contains(match, /<channelRef\\s+ref=\"channel-0\"/) and $not($contains(match, /<preview>\\s*[1-9]/))].{'version': groups[0], 'isStable': true}], 'sourceUrl': 'https://github.com/android/ndk'}",
            ],
        },
    },
    "packageRules": [
        {
            "matchPackageNames": [
                "/^org\\.jetbrains\\.compose(?:\\.[^:]+)*:/",
            ],
            "groupName": "Compose Multiplatform",
            "groupSingleUpdates": true,
            "ignoreUnstable": false,
            "respectLatest": false,
            "separateMajorMinor": false,
        },
        {
            "matchPackageNames": [
                "org.jetbrains.skiko:skiko",
            ],
            "enabled": true,
            "groupName": "Compose Multiplatform",
            "groupSingleUpdates": true,
            // Don't open a Skiko-only PR. Wait to group it with a Compose update.
            "minimumGroupSize": 2,
            "separateMajorMinor": false,
        },
    ],
}
